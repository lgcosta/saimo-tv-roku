<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="showItem" />
        <field id="focusPercent" type="float" onChange="updateFocus" />
        <field id="itemHasFocus" type="boolean" onChange="updateFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/core.bs" />
    <script type="text/brightscript" uri="pkg:/components/ChannelCard.bs" />
    <children>
        <Label visible="false"><Font id="channelTitleFont" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="16" /></Label>
        <Label visible="false"><Font id="channelMetaFont" role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="13" /></Label>
        <Rectangle id="cardBg" width="224" height="106" color="0x151021FF" />
        <Poster id="logo" translation="[8, 4]" width="48" height="48" loadDisplayMode="scaleToFit"
                loadingBitmapUri="pkg:/images/placeholder.png"
                failedBitmapUri="pkg:/images/placeholder.png" />
        <Label id="title" translation="[58, 6]" width="158" height="38"
               font="dictionary:channelTitleFont" color="0xF7F3FFFF" maxLines="2" />
        <Label id="meta" translation="[8, 54]" width="208" height="18"
               font="dictionary:channelMetaFont" color="0xB8B0CCFF" maxLines="1" />
        <Label id="program" translation="[8, 74]" width="208" height="28"
               font="dictionary:channelMetaFont" color="0x4FE3D0FF" maxLines="2" />
        <Poster id="focusHalo" width="224" height="106" uri="pkg:/images/focus_channel.png"
                opacity="0" loadSync="true" />
    </children>
</component>
